# Copier en « .env » et remplir. Ce fichier ne se commite jamais.

# La SEC exige une identification ; sans elle, elle répond 403 sans message.
QUANTLAB_USER_AGENT="Prenom Nom courriel@exemple.com"

# Facultatif : l'export CSV de fredgraph fonctionne sans clé.
QUANTLAB_FRED_API_KEY=

QUANTLAB_LOG_LEVEL=INFO
QUANTLAB_LOG_JSON=0
