.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
site/
.DS_Store
.ipynb_checkpoints/

# Le lac de données ne se commite jamais : il se reconstruit par script.
data/raw/**
data/bronze/**
data/silver/**
data/gold/**
!data/**/.gitkeep

# Les artefacts d'expérience non plus, sauf le registre lui-même.
artifacts/**
!artifacts/.gitkeep

# Clés et secrets.
.env
*.env
!.env.example

# Les études ne portent pas de cache Python.
studies/**/__pycache__/

# Les rapports d'étude sont régénérables et s'écrivent UNE FOIS PAR EXÉCUTION,
# donc les suivre revient à commiter dix copies des mêmes figures. Le répertoire
# « results/ » d'une étude est la copie canonique, celle que son README cite, et
# elle est suivie. Le rapport se refait par « uv run quant report generate ».
studies/**/reports/

# Phase 9 : les entrées et sorties de LEAN se reconstruisent par script.
lean/data/
